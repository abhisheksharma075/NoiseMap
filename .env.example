# Supabase Configuration (Optional for Cloud Mode, NoiseMap operates fully with in-memory offline fallback)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Map Provider Configuration (Defaults to high-resolution Stadia Alidade Dark)
# Supported options: stadia_dark | osm_dark | carto_dark
VITE_MAP_PROVIDER=stadia_dark
VITE_STADIA_API_KEY=

# NoiseMap AI Copilot - Server Default AI Integration
# Keep your keys secret: Never expose this to the browser client or commit to version control.
# Get a key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=replace_with_your_own_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Optional Server Default OpenAI Key
# Get a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

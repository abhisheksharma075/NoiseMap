# Supabase Configuration (Optional for Cloud Mode, NoiseMap operates fully with in-memory offline fallback)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Map Provider Configuration (Optional: defaults to high-availability CartoDB Dark Matter)
# Supported options: carto_dark | stadia_dark | maptiler_dark | osm_dark
VITE_MAP_PROVIDER=carto_dark
VITE_MAP_API_KEY=
